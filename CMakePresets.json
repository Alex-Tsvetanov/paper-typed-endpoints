{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "base",
      "displayName": "GCC 16, all layers including reflection",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "inherits": "base",
      "displayName": "GCC 16, Release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gcc-asan",
      "inherits": "base",
      "displayName": "GCC 16, ASan and UBSan without the null checks that break constant evaluation",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=null,nonnull-attribute,returns-nonnull-attribute -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "linux-clang-debug",
      "inherits": "base",
      "displayName": "clang 22 with libc++, portable layers only",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "linux-clang-asan",
      "inherits": "base",
      "displayName": "clang 22 with libc++, ASan and full UBSan, portable layers only",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-gcc1620-e2e",
      "inherits": "linux-gcc1620-asan",
      "displayName": "Pinned GCC 16.2.0 with ASan and UBSan, plus the end-to-end arms on a protobuf built with the same sanitizers (~/opt/protobuf-36.2-asan)",
      "cacheVariables": {
        "TEP_E2E": "ON",
        "TEP_PROTOBUF_ROOT": "$env{HOME}/opt/protobuf-36.2-asan"
      }
    },
    {
      "name": "linux-gcc1620-e2e-release",
      "inherits": "linux-gcc1620-release",
      "displayName": "Pinned GCC 16.2.0, Release -O2, plus the end-to-end arms on the pinned protobuf (~/opt/protobuf-36.2)",
      "cacheVariables": {
        "TEP_E2E": "ON",
        "TEP_PROTOBUF_ROOT": "$env{HOME}/opt/protobuf-36.2"
      }
    },
    {
      "name": "linux-clang-fuzz",
      "inherits": "linux-clang-asan",
      "displayName": "clang 22 with libc++, ASan and UBSan, plus libFuzzer executables of the portable parsers",
      "cacheVariables": {
        "TEP_FUZZ": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "inherits": "base",
      "displayName": "MSVC, portable layers only",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-release",
      "inherits": "base",
      "displayName": "MSVC Release, portable layers only",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-asan",
      "inherits": "base",
      "displayName": "MSVC with ASan, portable layers only",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "/fsanitize=address"
      }
    },
    {
      "name": "mingw-gcc-debug",
      "inherits": "base",
      "displayName": "MinGW-w64 GCC 16 on Windows (g++ first on PATH), all layers including reflection",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-gcc-release",
      "inherits": "base",
      "displayName": "MinGW-w64 GCC 16 on Windows, Release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc1620",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{HOME}/opt/gcc-16.2.0/bin/g++"
      }
    },
    {
      "name": "linux-gcc1620-release",
      "inherits": "gcc1620",
      "displayName": "Pinned GCC 16.2.0 (~/opt), Release -O2, static libstdc++ and libgcc (timed builds)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS": "-static-libstdc++ -static-libgcc"
      }
    },
    {
      "name": "linux-gcc1620-debug",
      "inherits": "gcc1620",
      "displayName": "Pinned GCC 16.2.0 (~/opt), Debug, runtime from its lib64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath,$env{HOME}/opt/gcc-16.2.0/lib64"
      }
    },
    {
      "name": "linux-gcc1620-asan",
      "inherits": "gcc1620",
      "displayName": "Pinned GCC 16.2.0 (~/opt), ASan and UBSan without the null checks (F2), runtimes from its lib64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=null,nonnull-attribute,returns-nonnull-attribute -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-rpath,$env{HOME}/opt/gcc-16.2.0/lib64"
      }
    }
  ]
}
